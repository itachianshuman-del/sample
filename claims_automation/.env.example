# Copy to .env (or export in your scheduler) and fill in real values.
# NEVER commit a populated .env. All secrets are read at runtime.

# --- Oracle (read-only service account) ------------------------------------
ORACLE_USER=svc_claims_ro
ORACLE_PASSWORD=
ORACLE_DSN=oracle-host.example.com:1521/CLAIMSPROD

# --- Macro template protection (only set what applies) ---------------------
# Required ONLY if the .xlsm asks for a password to OPEN it (file encryption).
TEMPLATE_OPEN_PASSWORD=
# Required ONLY if sheets are protected AND the macro does not self-unprotect.
TEMPLATE_SHEET_PASSWORD=

# --- BOT submission endpoint ----------------------------------------------
BOT_API_URL=https://bot.example.com/api/v1/submit
BOT_API_TOKEN=

# --- Notifications (optional) ---------------------------------------------
TEAMS_WEBHOOK_URL=

# --- Audit / identity ------------------------------------------------------
AUTOMATION_USER=svc-claims-bot

# --- Optional: pull all of the above from Azure Key Vault ------------------
# If set, secret NAMES above are looked up in the vault, with env as fallback.
# KEYVAULT_URL=https://your-vault.vault.azure.net/
